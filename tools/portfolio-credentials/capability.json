{
  "schemaVersion": 1,
  "provider": "cloudflare",
  "capability": "pages-direct-upload",
  "repository": {
    "remoteName": "origin",
    "remoteUrl": "https://github.com/pedro-rtm/marta-website.git",
    "branch": "main"
  },
  "credential": {
    "keychainService": "com.pedrortm.marta-website.cloudflare.pages-deploy",
    "keychainAccount": "api-token",
    "onePasswordItem": "Marta Website Cloudflare Pages Deploy"
  },
  "build": {
    "mode": "committed-tree"
  },
  "cloudflare": {
    "accountId": "82675093f8de0440782f81032b6a33d1",
    "pagesProject": "marta-website",
    "pagesProjectId": "5401624b-c5ae-4c4b-889b-560a1f317d7c",
    "productionBranch": "main"
  },
  "limits": {
    "commandTimeoutSeconds": 900,
    "apiTimeoutSeconds": 30,
    "deploymentTimeoutSeconds": 600,
    "minimumTokenLifetimeSeconds": 2592000,
    "maxArtifactFiles": 20000,
    "maxArtifactFileBytes": 26214400,
    "maxArtifactTotalBytes": 1073741824
  }
}
